# ==============================================================================
# DecisionLens Environment Configuration
# All sensitive keys must be kept here. NEVER commit .env to version control.
# ==============================================================================

# Application & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev_secret_key_decisionlens_super_secret_replace_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL or SQLite)
# Default for zero-config local development is SQLite.
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/decisionlens
DATABASE_URL=sqlite:///./decisionlens.db

# LLM Providers (Kept on backend ONLY, never passed to browser)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=gemini

# Search & Research Providers (Backend only)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Speech-to-Text & Media Processing
STT_PROVIDER=local_whisper
AUDIO_TEMP_DIR=./data/audio_temp
MAX_UPLOAD_SIZE_MB=100

# Web Application (Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
