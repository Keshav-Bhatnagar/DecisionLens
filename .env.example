# ==============================================================================
# DecisionLens — Unified Environment Configuration Template (.env.example)
# Copy this file to `.env` in the project root to configure both Backend & Frontend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DEPLOYMENT
# ------------------------------------------------------------------------------
PROJECT_NAME="DecisionLens API"
DEBUG=false
ENVIRONMENT="production"

# Security (Generate a random 32+ character key: `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-secure-random-32-char-secret-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM="HS256"

# Database: SQLite (default local) or PostgreSQL / Supabase
# SQLite:
DATABASE_URL="sqlite:///./decisionlens.db"
# Supabase / PostgreSQL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Storage & Uploads
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=25

# Allowed CORS Origins (JSON list or comma-separated URLs)
CORS_ORIGINS=["https://your-frontend-domain.com","http://localhost:3000"]

# ------------------------------------------------------------------------------
# 2. FRONTEND NETWORKING (Next.js)
# ------------------------------------------------------------------------------
# In local dev: http://localhost:8000
# In production behind a reverse proxy (same domain): leave empty ("")
# In production with separate domain backend: https://your-backend-api.com
NEXT_PUBLIC_API_URL=""
INTERNAL_API_URL="http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. AI & LLM CONFIGURATION (Gemini / OpenAI)
# ------------------------------------------------------------------------------
AI_PROVIDER="auto"

# Google Gemini (Recommended — get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_STRUCTURING_MODEL="gemini-3.5-flash"
GEMINI_GAPS_MODEL="gemini-3.5-flash"
GEMINI_FRAMEWORK_MODEL="gemini-3.1-flash-lite"

# OpenAI (Optional alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WHISPER_MODEL="whisper-1"

# ------------------------------------------------------------------------------
# 4. EXTERNAL LIVE WEB SEARCH
# ------------------------------------------------------------------------------
# Choose: "duckduckgo" (free live search, NO api key required), "tavily", or "serper"
SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""
SERPER_API_KEY=""

# ------------------------------------------------------------------------------
# 5. OAUTH IDENTITY PROVIDERS (Google, GitHub, Microsoft)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
NEXT_PUBLIC_GITHUB_CLIENT_ID=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=""

# ------------------------------------------------------------------------------
# 6. SUPABASE CLOUD AUTH & DATA
# ------------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
