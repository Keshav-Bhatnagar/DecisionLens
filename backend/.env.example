# Environment Configuration Template for DecisionLens Backend
# Copy this file to .env and fill in your secrets

# General Application Settings
PROJECT_NAME="DecisionLens API"
DEBUG=true
ENVIRONMENT="development"

# Security & Authentication
JWT_SECRET="decisionlens-development-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM="HS256"

# Database (SQLite default for local development, Supabase/PostgreSQL compatible)
# Local SQLite default:
DATABASE_URL="sqlite:///./decisionlens.db"
# Supabase PostgreSQL (Direct / Session Pooler, Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Supabase PostgreSQL (Transaction Pooler, Port 6543 - recommended for IPv4 networks):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=25

# CORS Settings (JSON list of allowed frontend origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:3002","http://127.0.0.1:3002"]

# AI Model & Provider Configuration
# Choose: "auto" (detects from keys), "gemini", "openai", or "mock"
AI_PROVIDER="auto"

# Google Gemini Configuration (Recommended)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI Configuration (Optional alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WHISPER_MODEL="whisper-1"

# Web Search Provider Configuration
# Choose: "duckduckgo" (free live search, NO api key required), "tavily", "serper", or "mock"
SEARCH_PROVIDER="duckduckgo"
SEARCH_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""

# Optional Speech-to-Text Key
GOOGLE_SPEECH_API_KEY=""

# OAuth Identity Providers (Google Workspace, GitHub, Microsoft Azure AD)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
