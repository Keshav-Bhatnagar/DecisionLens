# Environment Configuration for DecisionLens Backend

# General
PROJECT_NAME="DecisionLens API"
DEBUG=true
ENVIRONMENT="development"

# Security & Authentication
JWT_SECRET="decisionlens-development-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM="HS256"

# Database (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL="sqlite:///./decisionlens.db"

# Storage
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=25

# CORS Settings (comma-separated or JSON list of frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# External Services (Deferred to Phase 5 & 7, optional for Phase 1)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WHISPER_MODEL="whisper-1"

# Web Search Provider (Phase 8 - tavily, serper, duckduckgo, or mock)
SEARCH_PROVIDER="tavily"
SEARCH_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""

# Optional Speech-to-Text Key
GOOGLE_SPEECH_API_KEY=""
